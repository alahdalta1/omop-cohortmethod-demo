# --- renv -------------------------------------------------------------------
# The lockfile IS committed (that is the whole point); the library is not.
renv/library/
renv/local/
renv/cellar/
renv/staging/
renv/python/
renv/sandbox/

# --- R ----------------------------------------------------------------------
.Rhistory
.RData
.Rproj.user/
*.Rproj.user
.Ruserdata

# --- Data -------------------------------------------------------------------
# Eunomia unpacks a synthetic CDM into a local database file. It is derived
# data, it is ~15 MB, and it is reproducible from the Eunomia package, so it is
# regenerated rather than committed.
data/
*.sqlite
*.duckdb
*.zip

# --- Generated output -------------------------------------------------------
# Most output is reproducible from the scripts and is not committed.
#
# The exceptions are the figures, the results and diagnostic tables, the
# exploration tables and the generated cohort SQL. Those ARE committed,
# deliberately: README.md embeds the figures and cites the tables, and most
# readers of a portfolio repository read it on GitHub without running anything.
# Excluding them would leave broken images and uncheckable numbers. Together
# they come to roughly 330 KB.
output/**
!output/**/
!output/**/.gitkeep
!output/figures/*.png
!output/tables/*.csv
!output/explore/*.csv
!output/cohorts/*.csv
!output/cohorts/*.sql

# The serialised analysis objects and the Andromeda export are large and are
# rebuilt by analysis/03_run_cohort_method.R.
output/cohort_method/*.rds

# Andromeda / CohortMethod scratch files
andromedaTemp/
*.log
extras/*.log
extras/*.txt

# rJavaEnv project symlink to the per-user JDK cache
rjavaenv/

# Stray device output from non-interactive Rscript runs
Rplots.pdf
