# --- Data -------------------------------------------------------------------
# Eunomia unpacks a synthetic CDM into a local database file. It is derived
# data, it is ~30 MB, and it is reproducible from the Eunomia package, so it is
# regenerated rather than committed.
data/
*.sqlite
*.duckdb
*.zip

# --- Generated output -------------------------------------------------------
# Results are reproducible from the scripts. Keep the directory structure in
# git (via .gitkeep) but not the contents.


# Andromeda / CohortMethod scratch files
andromedaTemp/
*.log
extras/*.log
extras/*.txt

